---
/**
 * The reviews section, Kindling style: one large italic quote, a small
 * "01 / 03" counter, arrows either side, and a photo beside it.
 *
 * These are deliberately empty. Stephanie pastes her own real reviews in.
 * Nothing here is invented, and nothing moves on its own: the arrows are the
 * only way to change the quote.
 */
import Photo from './Photo.astro';

// Three empty slots, waiting for real words.
const slots = [1, 2, 3].map((n) => ({
  quote: '[Paste real review here]',
  name: '[Client name]',
  detail: '[Town, and what we cared for]',
  photo: `review-${n}.jpg`,
}));
---

<div class="quotes">
  <div class="quotes__head">
    <p class="quotes__counter" data-counter>01 / {String(slots.length).padStart(2, '0')}</p>
    <p class="eyebrow quotes__label">Kind words from our families</p>
  </div>

  <div class="quotes__grid">
    <div class="quotes__text">
      {
        slots.map((slot, i) => (
          <blockquote class="quotes__slide" hidden={i !== 0} data-slide>
            <p class="quotes__quote">{slot.quote}</p>
            <footer class="quotes__by">
              <span>{slot.name}</span>
              <span class="quotes__detail">{slot.detail}</span>
            </footer>
          </blockquote>
        ))
      }

      <div class="quotes__controls">
        <button type="button" class="quotes__arrow" data-prev>
          <span aria-hidden="true">&larr;</span>
          <span class="visually-hidden">Previous review</span>
        </button>
        <button type="button" class="quotes__arrow" data-next>
          <span aria-hidden="true">&rarr;</span>
          <span class="visually-hidden">Next review</span>
        </button>
      </div>
    </div>

    <div class="quotes__media">
      {
        slots.map((slot, i) => (
          <div class="quotes__photo" hidden={i !== 0} data-photo>
            <Photo src={slot.photo} alt="" ratio="3 / 4" />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .quotes__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .quotes__counter {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--caption);
  }

  .quotes__label {
    margin: 0;
  }

  .quotes__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 820px) {
    .quotes__grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: var(--space-xl);
    }
  }

  .quotes__slide {
    margin: 0;
  }

  .quotes__slide[hidden] {
    display: none;
  }

  .quotes__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.45rem, 3.6vw, 2.35rem);
    line-height: 1.34;
    color: var(--olive-ink);
    margin: 0 0 var(--space-md);
  }

  .quotes__by {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--caption);
  }

  .quotes__detail {
    letter-spacing: 0.1em;
    text-transform: none;
    font-size: 0.8rem;
  }

  .quotes__controls {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .quotes__arrow {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    font-size: 1rem;
    color: var(--olive);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .quotes__arrow:hover {
    background: var(--cream);
    color: var(--olive-ink);
  }

  .quotes__photo[hidden] {
    display: none;
  }
</style>

<script>
  document.querySelectorAll('.quotes').forEach((box) => {
    const slides = [...box.querySelectorAll('[data-slide]')];
    const photos = [...box.querySelectorAll('[data-photo]')];
    const counter = box.querySelector('[data-counter]');
    const total = slides.length;
    let current = 0;

    function show(index) {
      // Wraps around at both ends, so the arrows never dead-end.
      current = (index + total) % total;
      slides.forEach((slide, i) => (slide.hidden = i !== current));
      photos.forEach((photo, i) => (photo.hidden = i !== current));
      counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }

    box.querySelector('[data-prev]').addEventListener('click', () => show(current - 1));
    box.querySelector('[data-next]').addEventListener('click', () => show(current + 1));
  });
</script>
