---
/**
 * One photo slot.
 *
 * There are no real photos yet, so this shows a soft placeholder with the
 * exact filename it is waiting for. Drop a photo with that name into
 * /public/images/photos/ and this swaps to the real picture automatically.
 * No code needs to change.
 *
 *   <Photo src="hero-home.jpg" alt="Stephanie on a porch with a golden retriever" />
 */
import { existsSync } from 'node:fs';

const {
  src,
  alt = '',
  ratio = '4 / 3',
  tone = 'light',   // "dark" for placeholders sitting on bark or khaki
  frame = false,    // white border, like an instant photo
  tilt = 0,         // degrees, for the tilted instant photo look
  fill = false,     // stretch to fill whatever it sits in, for full-width heroes
  class: className = '',
  loading = 'lazy',
} = Astro.props;

const url = `/images/photos/${src}`;
const hasPhoto = existsSync(`public/images/photos/${src}`);
---

<figure
  class:list={[
    'photo',
    `photo--${tone}`,
    { 'photo--frame': frame, 'photo--fill': fill },
    className,
  ]}
  style={`--ratio: ${ratio}; --tilt: ${tilt}deg;`}
>
  {
    hasPhoto ? (
      <img src={url} alt={alt} loading={loading} decoding="async" />
    ) : (
      <div
        class="photo__placeholder"
        role="img"
        aria-label={alt || 'Photo coming soon'}
        title={`Waiting for ${src}`}
        data-photo={src}
      >
        <span class="photo__note">Photo coming soon</span>
      </div>
    )
  }
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    transform: rotate(var(--tilt));
  }

  .photo img,
  .photo__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The placeholder itself: a soft khaki to sand wash. */
  .photo__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1rem;
    text-align: center;
    background: linear-gradient(145deg, var(--khaki-band) 0%, var(--taupe) 100%);
  }

  .photo--dark .photo__placeholder {
    background: linear-gradient(145deg, #5d5a4a 0%, var(--taupe) 100%);
  }

  .photo__note {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(252, 250, 244, 0.92);
  }

  /* Stretches to fill whatever it sits in, for full-width heroes. */
  .photo--fill {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  /* Behind a hero headline there is no room for a label in the middle, so it
     tucks into the bottom corner instead of competing with the words. */
  .photo--fill .photo__placeholder {
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.15rem;
    padding: var(--gutter);
  }

  .photo--fill .photo__note {
    opacity: 0.55;
  }

  /* An instant-photo style white border. */
  .photo--frame {
    overflow: visible;
    background: #fdfdfb;
    padding: 10px 10px 34px;
    box-shadow: 0 10px 28px rgba(58, 58, 52, 0.18);
    aspect-ratio: auto;
  }

  .photo--frame img,
  .photo--frame .photo__placeholder {
    aspect-ratio: var(--ratio);
    height: auto;
  }
</style>
