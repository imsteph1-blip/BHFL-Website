---
/**
 * The questions people actually ask, each one tapping open to show the answer.
 *
 * Built on the browser's own open-and-close element, which means it works with
 * a tap, with the keyboard, and with a screen reader without any extra code,
 * and it still works if scripts fail to load.
 */
import { faqs } from '../data/services.js';
---

<div class="faq">
  {
    faqs.map((item) => (
      <details class="faq__item">
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__sign" aria-hidden="true"></span>
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 1.35em 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    letter-spacing: 0.02em;
    color: var(--olive-ink);
    cursor: pointer;
    list-style: none;
  }

  /* Hides the browser's default triangle so we can use our own plus sign. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--olive);
  }

  /* A plus that becomes a minus when the answer is open. */
  .faq__sign {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 1px;
    background: var(--olive);
    transition: transform 0.2s ease;
  }

  .faq__sign::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-bottom: 1.5em;
    max-width: 58ch;
    color: var(--charcoal);
  }
</style>
