---
/**
 * One empty review, waiting for real words.
 *
 * Nothing here is invented. Stephanie pastes a real review over the
 * placeholder text and deletes the brackets.
 */
const { label = 'What people say' } = Astro.props;
---

<figure class="review">
  <p class="eyebrow review__label">{label}</p>
  <blockquote class="review__quote">
    <p>[Paste real review here]</p>
  </blockquote>
  <figcaption class="review__by">
    <span>[Client name]</span>
    <span class="review__detail">[Town, and what we cared for]</span>
  </figcaption>
</figure>

<style>
  .review {
    margin: 0;
    padding: clamp(1.75rem, 5vw, 3rem);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    background: var(--warm-white);
    text-align: center;
  }

  .review__label {
    margin-bottom: var(--space-md);
  }

  .review__quote {
    margin: 0 0 var(--space-md);
  }

  .review__quote p {
    margin: 0;
    max-width: 30ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    line-height: 1.34;
    color: var(--olive-ink);
  }

  .review__by {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--caption);
  }

  .review__detail {
    letter-spacing: 0.1em;
    text-transform: none;
    font-size: 0.8rem;
  }
</style>
