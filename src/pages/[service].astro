---
/**
 * All four service pages are built from this one file.
 *
 * Astro makes one page per service in src/data/services.js, so Pet Care,
 * Home & Property, Farm & Homestead and Pet Transportation all stay in step
 * with each other. To change the words on a service page, edit that service
 * in src/data/services.js. To change the shape of all four pages, edit here.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import ReviewSlot from '../components/ReviewSlot.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { serviceDetails } from '../data/services.js';

export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// The other three services, for the row at the bottom of the page.
const others = serviceDetails.filter((s) => s.slug !== service.slug);
---

<Base title={service.seoTitle} description={service.seoDescription}>
  <PageHero
    title={service.name}
    line={service.heroLine}
    photo={service.photo}
    photoAlt={service.photoAlt}
    art={service.art}
  />

  {/* What this is ------------------------------------------------------- */}
  <section class="section">
    <div class="wrap wrap--narrow center">
      <img
        class="intro__art art"
        src={`/images/brand/prepared/${service.art}-olive.png`}
        alt=""
        aria-hidden="true"
      />
      <p class="intro__blurb">{service.blurb}</p>
    </div>
  </section>

  {/* What's included ---------------------------------------------------- */}
  <section class="section band-cream">
    <div class="wrap">
      <div class="center section__head">
        <p class="eyebrow">What&rsquo;s included</p>
        <h2>What we do, every time</h2>
      </div>

      <ul class="included">
        {
          service.included.map((item) => (
            <li class="included__item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* This is for you if -------------------------------------------------- */}
  <section class="section">
    <div class="wrap for-you">
      <div class="for-you__media">
        <Photo src={service.photo} alt={service.photoAlt} ratio="4 / 5" />
      </div>

      <div class="for-you__body">
        <p class="eyebrow">This is for you if</p>
        <h2>It sounds like your house</h2>
        <ul class="for-you__list">
          {service.forYouIf.map((line) => <li>{line}</li>)}
        </ul>

        {service.honestNote && <p class="for-you__note">{service.honestNote}</p>}
      </div>
    </div>
  </section>

  {/* Pricing ------------------------------------------------------------- */}
  <section class="section band-khaki center">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Starting from</p>
      <p class="price">{service.startingAt}</p>
      <p class="price__note">
        Every stay is quoted properly after a free meet-and-greet, so you are
        never guessing. No deposit.
      </p>
      <p class="price__actions">
        <a class="btn" href="/pricing/">See all pricing</a>
      </p>
    </div>
  </section>

  {/* A review ------------------------------------------------------------ */}
  <section class="section">
    <div class="wrap wrap--narrow">
      <ReviewSlot label={`${service.name} clients`} />
    </div>
  </section>

  {/* The other services --------------------------------------------------- */}
  <section class="section band-cream">
    <div class="wrap">
      <p class="eyebrow center">Also from us</p>
      <ul class="others">
        {
          others.map((other) => (
            <li class="others__item">
              <a href={other.href}>
                <img
                  class="others__art art"
                  src={`/images/brand/prepared/${other.art}-olive.png`}
                  alt=""
                  aria-hidden="true"
                />
                <span class="others__name">{other.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  /* ---- Opening line ----------------------------------------------------- */

  .intro__art {
    height: clamp(56px, 8vw, 84px);
    width: auto;
    margin: 0 auto var(--space-md);
  }

  .intro__blurb {
    max-width: 46ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    line-height: 1.5;
    color: var(--olive-ink);
  }

  .section__head {
    margin-bottom: var(--space-lg);
  }

  /* ---- What's included --------------------------------------------------- */

  .included {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .included {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg) var(--space-xl);
    }
  }

  .included__item {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }

  .included__item h3 {
    margin-bottom: 0.4rem;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    letter-spacing: 0.03em;
  }

  .included__item p {
    margin: 0;
    font-size: 0.94em;
  }

  /* ---- This is for you if ------------------------------------------------ */

  .for-you {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 900px) {
    .for-you {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-2xl);
    }
  }

  .for-you__list {
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .for-you__list li {
    position: relative;
    padding-left: 1.4em;
    margin-bottom: 0.5em;
  }

  .for-you__list li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--olive);
  }

  /* The plain-spoken line about what we do not do. */
  .for-you__note {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
    font-size: 0.92em;
    color: var(--caption);
  }

  /* ---- Pricing ----------------------------------------------------------- */

  .price {
    max-width: 30ch;
    margin: 0 auto var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    line-height: 1.35;
    color: var(--cream);
  }

  .price__note {
    max-width: 44ch;
    margin-inline: auto;
    font-size: 0.9rem;
    color: rgba(244, 239, 227, 0.88);
  }

  .price__actions {
    margin-top: var(--space-lg);
  }

  /* ---- The other services ------------------------------------------------ */

  .others {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .others__item a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    background: var(--warm-white);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .others__item a:hover {
    background: var(--cream);
  }

  .others__art {
    height: 54px;
    width: auto;
  }

  .others__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--olive-ink);
    text-align: center;
  }
</style>
